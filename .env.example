# Local Postgres (optional)
# DATABASE_URL="postgresql://postgres:PASSWORD@127.0.0.1:5433/Safadaru"

# Vercel + Prisma Postgres: pull from dashboard / `vercel env pull`
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Required on Vercel (not auto-set by Prisma Postgres)
AUTH_SECRET="generate-a-long-random-string"
ADMIN_BOOTSTRAP_PASSWORD="admin123"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
